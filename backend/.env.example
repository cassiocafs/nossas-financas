PORT=3001
CORS_ORIGIN=http://localhost:5173

# Postgres do Supabase (Settings > Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Auth (Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
# Preencher apenas se o projeto usar assinatura JWT simétrica (HS256).
# Se o projeto usar chaves assimétricas (JWKS/ES256), deixar em branco.
SUPABASE_JWT_SECRET=

# E-mail (Resend) — opcional em desenvolvimento, usa fallback de console se ausente
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@nossasfinancas.app
